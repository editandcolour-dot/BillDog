# Supabase (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Resend (Email Provider)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# RAG & Embeddings
VOYAGE_AI_API_KEY=

# Upstash Redis (For Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (worker scheduling + signed worker triggers)
QSTASH_TOKEN=                  # publish + schedules API token (QStash console)
QSTASH_CURRENT_SIGNING_KEY=    # verifies incoming worker requests (rotate together with next)
QSTASH_NEXT_SIGNING_KEY=       # second verification key for zero-downtime rotation
QSTASH_URL=                    # optional region override; default https://qstash-us-east-1.upstash.io

# PayFast (Payment Gateway)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_ITN_URL=https://www.yourdomain.com/api/webhooks/payfast

# Municipal Auto-Fetch (AES-256-GCM credential encryption)
# Generate via: openssl rand -hex 32
MUNICIPAL_CRED_ENCRYPTION_KEY=

# CoCT Portal Credentials (E2E testing only — never committed)
TEST_COCT_USERNAME=your_coct_username
TEST_COCT_PASSWORD=your_coct_password

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

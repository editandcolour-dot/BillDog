{
  "municipality_id": "city-of-cape-town",
  "version": "1.0",
  "steps": {
    "login": [
      {
        "selector": "#logonuidfield",
        "value": "${username}",
        "action": "fill"
      },
      {
        "selector": "#logonpassfield",
        "value": "${password}",
        "action": "fill"
      },
      {
        "selector": "input[name='uidPasswordLogon']",
        "action": "click"
      }
    ],
    "navigate": [
      {
        "selector": "#divContentArea",
        "timeout_ms": 5000,
        "action": "waitForSelector"
      },
      {
        "selector": "#tabIndex1",
        "action": "click"
      },
      {
        "selector": "#L2N5",
        "action": "click"
      },
      {
        "selector": "iframe[name='contentAreaFrame']",
        "action": "switchFrame"
      },
      {
        "type": "waitForTimeout",
        "ms": 5000
      }
    ],
    "filter_history": [
      {
        "selector": "iframe[name='isolatedWorkArea']",
        "action": "switchFrame"
      },
      {
        "type": "waitForTimeout",
        "ms": 5000
      },
      {
        "action": "select",
        "selector": "select[name='billType']",
        "value": "3"
      },
      {
        "action": "select",
        "selector": "select[name='searchDateId']",
        "value": "1825"
      },
      {
        "action": "click",
        "selector": "input[name='Search'][value='Find']"
      },
      {
        "type": "waitForTimeout",
        "ms": 8000
      }
    ]
  },
  "extraction": {
    "row_selector": "#DataTable tbody tr:not(:first-child):not(:has(td:empty))",
    "period_selector": "",
    "pdf_link_selector": "a[href*=\"bills.pdf?doAction=showBillPDF\"]",
    "pagination_next_selector": "a[title='Next Page']",
    "pagination_disabled_condition": "display:none"
  }
}